# RuStore Pay (только Android-сборка rustore). Для yarn web / iOS можно оставить пустым.
# ID приложения из консоли RuStore: https://console.rustore.ru → приложение → apps/{ID}/
RUSTORE_CONSOLE_APP_ID=
# SKU в консоли: premium_monthly (599), premium_yearly (4990), premium_lifetime (6990)
RUSTORE_PREMIUM_PRODUCT_ID=premium_monthly

# Backend API (auth, consent records, premium interpretations)
API_BASE_URL=https://tarot.sorapure.fun
