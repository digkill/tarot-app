PORT=8080
DATABASE_URL=postgres://tarot:tarot@localhost:5432/tarot?sslmode=disable
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# 32-byte key as 64 hex characters. Used to encrypt IP / User-Agent at rest.
# openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Kie.ai — GPT-5.6 Luna for premium interpretations
# Key: https://kie.ai/api-key
# Docs: https://docs.kie.ai/market/chat/gpt-5-6-luna
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_TAROT_MODEL=gpt-5-6-luna
# low | medium | high | xhigh  (low is cheapest)
KIE_REASONING_EFFORT=low

# Official OpenAI fallback after Kie retries
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TAROT_MODEL=gpt-4o-mini

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=*

# Beget SMTP — https://beget.com/ru/kb/how-to/mail/obshhie-svedeniya
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USERNAME=tarot@sorapure.fun
SMTP_PASSWORD=
SMTP_FROM=tarot@sorapure.fun
SMTP_FROM_NAME=Tarot

# HTML-админка: https://<host>/admin
# Если пользователя с этим email нет — он будет создан (роль admin, почта подтверждена).
# Если уже есть — только выдаётся роль admin, пароль не меняется.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DECK_STORAGE_DIR=data/decks

# Public site used for YooKassa return URLs and the iOS payment overlay.
PUBLIC_BASE_URL=https://tarot.sorapure.fun
# YooKassa (iOS / web gateway). Leave empty to disable checkout.
# Webhook in YooKassa cabinet: https://tarot.sorapure.fun/api/v1/billing/yookassa/webhook
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
