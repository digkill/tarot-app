PORT=8080
DATABASE_URL=postgres://tarot:tarot@localhost:5432/tarot?sslmode=disable
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
# 32-byte key as 64 hex characters. Used to encrypt IP / User-Agent at rest.
# openssl rand -hex 32
PII_ENCRYPTION_KEY=

# Kie.ai — GPT-5.6 Luna for premium interpretations
# Key: https://kie.ai/api-key
# Docs: https://docs.kie.ai/market/chat/gpt-5-6-luna
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai
KIE_TAROT_MODEL=gpt-5-6-luna
# low | medium | high | xhigh  (low is cheapest)
KIE_REASONING_EFFORT=low

# Official OpenAI fallback after Kie retries
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_TAROT_MODEL=gpt-4o-mini

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CORS_ALLOWED_ORIGINS=*

# Beget SMTP — https://beget.com/ru/kb/how-to/mail/obshhie-svedeniya
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USERNAME=tarot@sorapure.fun
SMTP_PASSWORD=
SMTP_FROM=tarot@sorapure.fun
SMTP_FROM_NAME=Tarot

# HTML-админка: https://<host>/admin
# Если пользователя с этим email нет — он будет создан (роль admin, почта подтверждена).
# Если уже есть — только выдаётся роль admin, пароль не меняется.
ADMIN_EMAIL=
ADMIN_PASSWORD=
DECK_STORAGE_DIR=data/decks

# Public site used for YooKassa return URLs and the iOS payment overlay.
PUBLIC_BASE_URL=https://tarot.sorapure.fun
# YooKassa (iOS / web gateway). Leave empty to disable checkout.
# Webhook in YooKassa cabinet: https://tarot.sorapure.fun/api/v1/billing/yookassa/webhook
# IS_PROD=false uses YOOKASSA_*_TEST (sandbox). Default true uses live keys.
IS_PROD=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SHOP_ID_TEST=
YOOKASSA_SECRET_KEY_TEST=
# VAT code for receipt items; 1 means no VAT. Must match the merchant's settings.
YOOKASSA_VAT_CODE=1

# CloudPayments (iOS, foreign cards, USD). Leave empty to disable.
# Pay notification in the CloudPayments cabinet (site settings):
#   https://tarot.sorapure.fun/api/v1/billing/cloudpayments/pay
# IS_PROD=false uses CLOUDPAYMENTS_*_TEST, same switch as YooKassa.
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_PUBLIC_ID_TEST=
CLOUDPAYMENTS_API_SECRET_TEST=

# Apple In-App Purchase (StoreKit 2), used by the native iOS client.
# Server Notifications V2 URL — set it for BOTH Production and Sandbox in
# App Store Connect > App Information > App Store Server Notifications:
#   https://tarot.sorapure.fun/api/v1/billing/apple/notifications
#
# NOTE: unlike YooKassa and CloudPayments there are deliberately NO *_TEST
# twins here, and IS_PROD does not apply. The same key and bundle id serve both
# Apple environments; Apple marks each transaction itself with an `environment`
# claim, and only the API host differs.
APPLE_BUNDLE_ID=org.mediarise.tarot
# Numeric App Store app id. Optional: when set, notification payloads are
# checked against it as well as against the bundle id.
APPLE_APP_APPLE_ID=
# App Store Connect > Users and Access > Integrations > In-App Purchase key.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# The AuthKey_XXXXXXXXXX.p8 contents: base64 of the whole file (recommended,
# single line and docker-safe), or the raw PEM with literal \n escapes.
# Leave empty to disable purchase verification against Apple's servers;
# signature verification of client-supplied transactions still works.
APPLE_IAP_PRIVATE_KEY=
# Alternative to the above: a path to the .p8 file.
APPLE_IAP_PRIVATE_KEY_FILE=
# Accept Sandbox transactions. MUST stay true: App Review buys in Sandbox
# against the production build, and TestFlight reports Sandbox too. Setting it
# to false breaks both.
APPLE_ALLOW_SANDBOX=true
# Optional override of the embedded Apple Root CA G3 (PEM or DER). Only needed
# if Apple ever rotates the root; the certificate is pinned in the binary.
APPLE_ROOT_CA_FILE=
